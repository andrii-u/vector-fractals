{
  "name": "@andrii-u/vector-fractals",
  "version": "1.0.0",
  "description": "Generate beautiful vector fractals and generative patterns as platform-agnostic primitives, with React (SVG) and Canvas 2D adapters.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./react": {
      "import": { "types": "./dist/fractal-builders.d.ts", "default": "./dist/fractal-builders.js" },
      "require": { "types": "./dist/fractal-builders.d.cts", "default": "./dist/fractal-builders.cjs" }
    },
    "./canvas": {
      "import": { "types": "./dist/fractal-canvas.d.ts", "default": "./dist/fractal-canvas.js" },
      "require": { "types": "./dist/fractal-canvas.d.cts", "default": "./dist/fractal-canvas.cjs" }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:pkg": "publint && attw --pack",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "fractal",
    "svg",
    "canvas",
    "vector",
    "generative",
    "art",
    "pattern",
    "mathematical",
    "geometry"
  ],
  "author": "Andrii Ursolov <andrii.ursolov@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrii-u/vector-fractals.git"
  },
  "bugs": {
    "url": "https://github.com/andrii-u/vector-fractals/issues"
  },
  "homepage": "https://github.com/andrii-u/vector-fractals#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.0",
    "@types/react": "^19.0.0",
    "publint": "^0.2.0",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
